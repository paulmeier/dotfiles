# Secret *references* for Proton Pass. Tracked in a PUBLIC repo:
# only pass://Vault/Item/field references go here, never values.
#
# `pp-sync` (in ~/.zshrc) resolves these and writes the exports into
# ~/.zshrc.local, so every new shell has them.
#
# Add a secret:
#   pass-cli item create login --vault-name Personal --title "My Item" --password "$(pbpaste)"
# then add a line:  MY_VAR=pass://Personal/My Item/password  and run pp-sync

# Tailscale API (tailscale MCP server)
TAILSCALE_API_KEY=pass://Personal/Tailscale API/password
TAILSCALE_TAILNET=pass://Personal/Tailscale API/username

# Claude Code long-lived OAuth token (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=pass://Personal/Claude Code OAuth Token/password

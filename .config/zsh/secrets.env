# Secret *names* for the macOS Keychain. Tracked in a PUBLIC repo:
# only variable names go here, never values.
#
# Each name is a generic password in the login Keychain (service = the name).
# `ks-sync` (in ~/.zshrc) reads them and writes the exports into
# ~/.zshrc.local, so every new shell has them.
#
# Add a secret:  ks-add MY_VAR, add a line  MY_VAR  here, then run ks-sync

# Tailscale API (tailscale MCP server)
TAILSCALE_API_KEY
TAILSCALE_TAILNET

# Claude Code long-lived OAuth token (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN

# Emacs identity (config.el reads these)
USER_MAIL_ADDRESS
GPG_KEY_ID

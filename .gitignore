# Allowlist: this PUBLIC repo tracks only Doom, EWS, zsh and Starship config,
# plus a few scripts in ~/.local/bin.
# Everything else is ignored by default, so nothing lands here by accident.
# To track something new, add a `!` rule below and make sure it's secret-free.
/*
!/.gitignore
!/.stow-local-ignore
!/README.md
!/.zshrc
!/.config/
/.config/*
!/.config/doom/
!/.config/ews/
!/.config/zsh/
!/.config/starship.toml

# Doom: paths to my data
/.config/doom/local.el

# EWS: only my own files; upstream (bootstrap.sh) and runtime state are ignored
/.config/ews/*
!/.config/ews/early-init.el
!/.config/ews/user.el
!/.config/ews/bootstrap.sh

# Never, anywhere
.DS_Store
*~
\#*\#
.\#*
*.elc
.authinfo*
.env
.env.*
*.local

# ~/.local/bin: only named scripts (after `*.local`, which would match the dir)
!/.local/
/.local/*
!/.local/bin/
/.local/bin/*
!/.local/bin/syncthing-sync-folders
